  "exceptions": {
    "command_failed": {
      "message": "The secomat command failed: {error}"
    },
    "entry_not_found": {
      "message": "No secomat configuration entry with this ID."
    },
    "entry_not_loaded": {
      "message": "The secomat configuration entry is not loaded."
    }
  },
  "services": {
    "start_at": {
      "name": "Start drying at",
      "description": "Schedules laundry drying to start at the given time.",
      "fields": {
        "config_entry_id": {
          "name": "secomat",
          "description": "The secomat to schedule."
        },
        "start": {
          "name": "Start",
          "description": "Date and time to start drying. Times in the past start immediately."
