{
  "config": {
    "step": {
      "user": {
        "title": "secomat",
        "description": "Enter the claim token of your secomat. It can be read once via Bluetooth with tools/read_token.py (see README).",
        "data": {
          "token": "Claim token",
          "name": "Name"
        },
        "data_description": {
          "token": "Device secret used by the official app. Never share it.",
          "name": "Name of the device in Home Assistant."
        }
      },
      "reauth_confirm": {
        "title": "Re-enter claim token",
        "description": "The secomat cloud rejected the stored claim token. Enter the current token of this secomat.",
